# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Agora RTC (certificate stays on the backend only)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Redis (docker-compose overrides this to redis://redis:6379)
REDIS_URL=redis://localhost:6379

JWT_SECRET=

# Firebase Admin SDK — JSON string on Render, or place
# backend/firebase-service-account.json locally instead
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Gemini (empty = /ai/* endpoints return 503)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
